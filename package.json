{
  "name": "@holmconsulting/cli-multiregnskab",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "mr": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --target node --define '__VERSION__=\"dev\"' --outfile dist/index.js && chmod +x dist/index.js",
    "dev": "bun run src/index.ts",
    "prepublishOnly": "bun run build",
    "generate-api": "openapi-typescript public-client-api-v1.yaml -o src/api/types.ts",
    "prepare": "bun run build"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "openapi-fetch": "^0.13.5"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "openapi-typescript": "^7.8.0",
    "typescript": "^5.0.0"
  }
}
